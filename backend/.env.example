# ---- Required ----

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (full database access)
# Use whichever name your Supabase dashboard shows — both work:
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# or: SUPABASE_SECRET_KEY=your_secret_key

# Application JWT secret for admin authentication (any strong random string)
JWT_SECRET=your_jwt_secret

# ---- Optional ----

PORT=5000
NODE_ENV=production
